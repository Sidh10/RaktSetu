# RaktSetu prototype settings. Copy to .env (git-ignored) and edit; the API and `make seed` load it at start-up.
# Variables already set in your shell take precedence. NEVER commit .env or put a real key in this example file.

# --- Database (ADR-001) ---
# Default: SQLite file in data/. Optional Postgres (untested; needs `pip install "psycopg[binary]"`):
#   postgresql+psycopg://raktsetu:raktsetu@localhost:5432/raktsetu
DATABASE_URL=sqlite:///./data/raktsetu_demo.db

# --- Demo mode (ADR-004): seeded users, role switcher, NOT real authentication ---
RAKTSETU_DEMO_MODE=true
RAKTSETU_TZ=Asia/Kolkata

# --- Matching (docs/MATCHING_POLICY.md) ---
# strict = ABO/RhD-identical (DGHS/NBTC 2023 manual default); standard / relaxed need medical-officer acknowledgement
RAKTSETU_DEFAULT_POLICY=strict
# Team-chosen safety margin, not a regulation (sim_v3/PREREGISTRATION_v3.md, Amendment 2)
RAKTSETU_MARGIN_HOURS=12
# Default courier time when no per-pair estimate is seeded. ASSUMPTION, as in the simulator (PREREGISTRATION_v3.md §3.4)
RAKTSETU_DEFAULT_TRANSPORT_MIN=90

# --- Parser (ADR-003) ---
# rules = rule-based only (works offline); llm = Claude extraction, rules as fallback; auto = llm if a key is set
RAKTSETU_PARSER_MODE=auto
# Leave empty to run fully offline. Set in your shell or .env only.
ANTHROPIC_API_KEY=
RAKTSETU_LLM_MODEL=claude-opus-5-5
RAKTSETU_LLM_TIMEOUT_S=15

# --- Frontend (Vite) ---
VITE_API_BASE=http://localhost:8000
